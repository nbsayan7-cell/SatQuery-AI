# =============================================================================
# SatQuery AI - Environment Configuration
# =============================================================================

# Server settings
PORT=8000
DEBUG=False

# 24/7 Cloud Multimodal AI & LLM Inference (100% Free)
# 1. Google Gemini (Get free key in 30s at https://aistudio.google.com/app/apikey)
# Enables 24/7 Multimodal Satellite VLM (Visual Question Answering + Scene Captioning + Object Detection)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Groq Cloud (Get free key in 30s at https://console.groq.com/keys)
# Enables ultra-fast LLaMA 3.3 70B text chat & remote sensing query synthesis
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Optional Local Ollama (Used automatically when running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# 24/7 Server Keep-Alive (Prevents Render / Koyeb free tier from spinning down)
# Set to your live Render public URL (e.g., https://satquery-backend.onrender.com)
SELF_PING_URL=https://your-backend-app.onrender.com
KEEP_ALIVE_INTERVAL_SEC=600
